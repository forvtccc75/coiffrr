{
  "name": "zyass-barber-platform",
  "version": "1.0.0",
  "private": true,
  "description": "Plateforme SaaS de réservation, d'acquisition et de fidélisation pour BARBER SHOP Z.yass — site commercial, moteur de réservation, CRM, waitlist, automatisations, fidélité, analytics et back-office multi-salon.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19 <23"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "tsx watch --tsconfig server/tsconfig.json server/index.ts",
    "dev:web": "vite",
    "build": "vite build && npm run build:server && npm run prerender",
    "preview": "vite preview",
    "start": "NODE_ENV=production tsx --tsconfig server/tsconfig.json server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test tests/*.test.ts",
    "admin:new": "node --import tsx scripts/admin-bootstrap.mts",
    "smoke": "node --import tsx scripts/smoke.ts",
    "smoke:http": "bash scripts/smoke.sh",
    "check": "npm run typecheck && npm run test && npm run smoke && npm run build:strict && npm run audit:site && npm run test:vercel && npm run test:assets",
    "prerender": "node --import tsx scripts/prerender.mts",
    "seed": "node --import tsx server/seed/cli.ts",
    "db:reset": "npm run seed -- --fresh",
    "migrate": "node --import tsx server/db/migrate.ts",
    "icons": "node scripts/gen-icons.mjs",
    "e2e": "playwright test",
    "e2e:install": "playwright install --with-deps chromium",
    "audit:secrets": "node scripts/audit-secrets.mjs",
    "audit:site": "node scripts/audit-site.mjs",
    "e2e:adaptivite": "playwright test tests/e2e/responsive.spec.ts",
    "verify": "bash scripts/verify.sh",
    "verify:pg": "PG=1 bash scripts/verify.sh",
    "pg:check": "bash scripts/pg-check.sh",
    "db:sql": "node --import tsx scripts/emit-sql.mts",
    "sim:supabase": "bash scripts/supabase-sim.sh",
    "guide": "python3 scripts/build-guide.py",
    "build:strict": "vite build && npm run build:server && PRERENDER_STRICT=1 npm run prerender",
    "build:server": "node scripts/build-server.mjs",
    "test:vercel": "node scripts/test-vercel-runtime.mjs",
    "test:assets": "node scripts/test-static-runtime.mjs",
    "test:navigation": "node scripts/test-navigation-browser.mjs",
    "test:mobile": "node scripts/test-mobile-app.mjs"
  },
  "dependencies": {
    "@hono/node-server": "1.13.7",
    "better-sqlite3": "^12.11.1",
    "hono": "4.6.14",
    "pg": "8.13.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "22.10.2",
    "@types/pg": "8.11.10",
    "@types/react": "18.3.17",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "4.3.4",
    "esbuild": "0.23.1",
    "playwright": "1.63.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vite": "5.4.11"
  },
  "type": "module"
}
