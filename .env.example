# Variables lues par le code (server/lib/env.ts, puis process.env direct pour Twilio/WhatsApp/WEB_PORT).
# Toute variable absente de cette liste est IGNOREE par l'application — les vérifier avant d'y croire.
# Mise en ligne pas à pas (Vercel + Supabase + SQL + WhatsApp) : docs/GUIDE-MISE-EN-LIGNE.md

# ── Coeur ───────────────────────────────────────────────────────────
PORT=8787                                   # ignoré sur Vercel (le runtime lie le port)
APP_URL=https://rdv.zyass-barber.fr         # Liens signés des SMS/emails, cookies, canonical, JSON-LD. Sans / final.
TIMEZONE=Europe/Paris                       # Journeys, rappels, « aujourd'hui », seeds
NODE_ENV=development                        # Vercel met « production » tout seul : c'est ce qui éteint la démo
# IS_PROD=1                                 #   alternative si NODE_ENV n'est pas posé (même effet)
DEMO_MODE=1                                 # 1 = seed auto, comptes de démo (owner@zyass.fr / demo-owner), notifications stdout.
                                            # En production : éteint automatiquement. Le remettre à 1 = choice assumée (staging).
DEMO_SLUG=zyass                             # Salon servi quand la requête ne précise ni sous-domaine ni ?loc=
TRUST_PROXY=1                               # 1 (défaut) : X-Forwarded-For/x-real-ip font foi pour la limite de débit.
                                            # 0 : les deux en-têtes sont IGNORÉS (à poser si le port nu est exposé, sinon les 429 se contournent).
APP_ROOT=                                   # uniquement pour le chargeur .env (dossier où lire .env / .env.local)

# ── Base de données ─────────────────────────────────────────────────
# Vide => SQLite local (fichier DATA_FILE). En production : URL Postgres (Supabase/Neon).
# Chez Supabase, prendre le pooler en mode SESSION (port 5432) : le mode transaction (6543)
# n'a pas été validé ici pour ce projet ; rester sur le mode SESSION testé.
# `?sslmode=require` peut rester dans l'URL collée depuis Supabase : le code le retire et pose
# lui-même la bonne option TLS (chiffré, chaîne autosignée non vérifiée). Rien d'autre à faire.
DATABASE_URL=
DATA_FILE=./data/zyass.db
PG_POOL_MAX=10                              # connexions du pool `pg` PAR instance serverless (mettre 5 sur Vercel)
# sslmode lus par server/db/pg-options.ts : disable | require | no-verify | verify-ca | verify-full.
# verify-full (chaîne + nom d'hôte vérifiés) est à poser dès que l'hébergeur fournit un certificat valide.

# ── Sécurité (3 secrets distincts, 32 octets minimum : openssl rand -hex 32) ──
SESSION_SECRET=
TOKEN_SECRET=
CRON_SECRET=                                # appelé par Vercel Cron / le relais GitHub sur /api/internal/cron

# ── Paiements ───────────────────────────────────────────────────────
PAYMENTS_PROVIDER=off                       # off = paiement sur place | demo | stripe   (Stripe live = 'stripe' + les deux clés ci-dessous)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=                      # whsec_... du endpoint /api/internal/webhooks/stripe (corps brut)

# ── Notifications : e-mail ──────────────────────────────────────────
EMAIL_PROVIDER=stdout                       # stdout | brevo | resend (API HTTP, pas SMTP)
BREVO_API_KEY=                              # clé API Brevo v3, PAS un mot de passe SMTP
EMAIL_FROM_NAME=Z.YASS Barber Shop           # nom si EMAIL_FROM contient uniquement une adresse
EMAIL_REPLY_TO=                             # optionnel, adresse qui recevra les réponses
RESEND_API_KEY=                             # facultatif, uniquement EMAIL_PROVIDER=resend
EMAIL_FROM=Z.YASS Barber Shop <no-reply@zyass-barber.fr>

# ── Notifications : messages texte (SMS et WhatsApp) ────────────────
# Le canal texte des rappels est choisi par NOTIFY_TEXT_CHANNEL ; sinon WhatsApp dès qu'un
# fournisseur WhatsApp est branché, sinon SMS. Sans fournisseur, les messages sont écrits dans
# la table `notifications`. stdout simule un envoi (statut sent), mais NE livre RIEN.
# Après raccordement : relancer manuellement les messages pertinents, pas des OTP expirés.
NOTIFY_TEXT_CHANNEL=                        # vide = auto | sms | whatsapp
SMS_PROVIDER=stdout                         # stdout | twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=whatsapp:+33...                 # ex. whatsapp:+14155238886 (numéro de démo Twilio) ; pour du SMS, retirer le préfixe
# WhatsApp Business (Meta) : le raccordement se fait sur developer.facebook.com → app WhatsApp.
WHATSAPP_PROVIDER=                          # vide/stdout = désactivé | meta | twilio (twilio = retombe sur les clés SMS ci-dessus)
WHATSAPP_ACCESS_TOKEN=                      # jetat permanent de l'app Meta (System User)
WHATSAPP_PHONE_NUMBER_ID=                   # id du numéro Business, pas le numéro lui-même (ex. 123456789012345)
WHATSAPP_API_VERSION=v21.0                  # version de Graph API à appeler
WHATSAPP_TEMPLATE_NAME=                     # modèle approuvé pour les rappels hors fenêtre de 24 h après message WHATSAPP du client (pas après réservation web).
WHATSAPP_TEMPLATE_LANG=fr                   # langue du gabarit, si gabarit il y a

# ── Avis / intégrations ─────────────────────────────────────────────
GOOGLE_REVIEW_URL=                          # lien « laisser un avis Google » (sinon celui du brand en base)
GSC_ANALYTICS=none                          # lu par env.analytics mais AUCUN usage dans le code à ce jour

# ── Dev / scripts seulement (ne rien mettre en production) ──────────
# TICK_EVERY_SEC=60        # intervalle du tick en local ; inactif dès que NODE_ENV=production
# CRON_FULL_EVERY_MIN=60   # MALNOMMÉ : toute valeur non nulle = tick COMPLET à chaque cron ; 0 = jamais de tick complet
# WEB_PORT=5173            # port du site en dev (scripts/dev.mjs)
# TZ=Europe/Paris          # forcé par les scripts de build/pré-rendu/smoke
# TEST_DB=memory|pg        # tests : force SQLite en mémoire ou la voie Postgres
# PRERENDER_STRICT=1     # build : sortir en 1 si une page ne se pré-rend pas (utilisé par `npm run build:strict`)
# PRERENDER_DB=live      # build : pré-rendre contre la vraie base (exige qu'elle réponde au build) — sinon mode autonome mémoire + démo
# PRERENDER_TIMEOUT_MS   # build : chien de garde du pré-rendu (150000 par défaut, plancher 10000)
# SMOKE_JSON=1             # scripts/smoke.ts : sortie JSON

# Premier administrateur (production uniquement, retirer après connexion).
# Initialise un salon vide et un owner s'il n'existe aucun propriétaire ; ne réinitialise jamais un mot de passe.
# BOOTSTRAP_OWNER_EMAIL=toi@example.com
# BOOTSTRAP_OWNER_PASSWORD=mot-de-passe-unique-de-12-caracteres-minimum
# BOOTSTRAP_OWNER_NAME=Zineddine
